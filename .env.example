# Kopiere diese Datei zu .env und fülle echte Werte ein.
# Die echte .env wird durch .gitignore ausgeschlossen — niemals committen.

# ElevenLabs API – Server-side (für scripts/generate-audio)
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Client-side (Browser nutzt diese für personalisierte Greetings).
# VORSICHT: VITE_-Variablen sind im JS-Bundle sichtbar.
VITE_ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_ELEVENLABS_VOICE_ID=
VITE_ELEVENLABS_MODEL_ID=eleven_multilingual_v2
