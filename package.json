{
  "name": "lernapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lern-Browser-Spiel für Kinder – Mathematik (1. Klasse aufwärts), erweiterbar um weitere Fächer und Sprachen.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit",
    "audio:generate": "tsx scripts/generate-audio.ts",
    "sound:generate": "tsx scripts/generate-sounds.ts"
  },
  "dependencies": {
    "dexie": "^4.0.10",
    "i18next": "^23.16.6",
    "phaser": "^3.87.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.16",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1"
  }
}
